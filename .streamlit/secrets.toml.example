# Copy this file to .streamlit/secrets.toml and fill in your own values.
# NEVER commit secrets.toml or share the service_role key.

[supabase]
# Supabase Dashboard -> Project Settings -> API (or "Data API")
url = "https://YOUR-PROJECT-ID.supabase.co"
# Use the "service_role" (secret) key. The app runs on the server, so this key
# is never sent to the browser. The tables have Row Level Security turned on
# with no policies, so the public "anon" key cannot read anything.
key = "YOUR-SERVICE-ROLE-KEY"

[app]
# Timezone used to show times and to read the times teachers enter.
timezone = "Asia/Manila"
